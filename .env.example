# Backend-only secrets; never put these in the Expo app.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE
JWT_SECRET=generate-a-long-random-secret
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
# Must exactly match the Google Cloud authorized redirect URI.
GOOGLE_OAUTH_REDIRECT_URI=https://YOUR_BACKEND_DOMAIN/api/google/oauth/callback

# Optional server settings
PORT=3000
NODE_ENV=production
# Optional: the web frontend URL used after connecting Gmail from web.
EXPO_WEB_PREVIEW_URL=https://YOUR_WEB_APP_DOMAIN
